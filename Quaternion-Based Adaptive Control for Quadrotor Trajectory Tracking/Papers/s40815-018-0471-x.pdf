      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/postscript</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Trajectory Tracking Using Backstepping Sliding-Mode Control for a Ball Robot with a Four-Motor Inverse Mouse-Ball Drive</rdf:li>
            </rdf:Alt>
         </dc:title>
